# ROCm Claude Workspace .gitignore

/rocm

# Workspace state (vscode commands, active task, etc.)
.state/
.claude/active-task

# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# Local skill discovery junctions; canonical source is in skills/.
.agents/skills/review-panel
.claude/skills/review-panel

# Review evidence and optional private reference routing stay local.
.cache/review-runs/
.cache/peanut-review/
.peanut-review.json
.pytest_cache/
*.egg-info/
LOCAL_CONTEXT.md

# Temporary files
*.tmp
*.swp
*.swo
*~
.DS_Store

# Editor files
.vscode/
.idea/
*.sublime-*

# Build artifacts (if you ever test builds here)
build/
*.o
*.a
*.so

# Logs
*.log

# Personal notes that shouldn't be shared
personal-notes/
scratch/

# Environment-specific configs
.env
.env.local

# Python cache (if you add Python scripts)
__pycache__/
*.pyc
*.pyo

# Backup files
*.bak
*.backup

# OS files
Thumbs.db

# Python venvs
*.venv
